# DynamoDB Configuration for AI-IDP
# Copy these variables to your .env file

# AWS Region (for both LocalStack and production)
AWS_REGION=us-east-1

# LocalStack endpoint (for local development)
# Comment out for production use
AWS_ENDPOINT=http://localhost:4566

# AWS Credentials (optional for LocalStack, required for production)
# For LocalStack, these can be dummy values
# For production, use real AWS credentials or IAM roles
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB Table Names
APPROVALS_TABLE_NAME=ai-idp-approvals
CHAT_SESSIONS_TABLE_NAME=ai-idp-chat-sessions

# Optional: Create chat sessions table for future use
CREATE_CHAT_SESSIONS_TABLE=false

# Environment type
NODE_ENV=development