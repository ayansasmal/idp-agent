{
  "name": "ai-idp-modular",
  "version": "2.0.0",
  "description": "AI-Powered Integrated Developer Platform with Real Agent Integration, Next.js Web Application, and Human Approval Workflow",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "nx dev web-app",
    "dev:web": "nx dev web-app",
    "dev:core": "nx dev core",
    "dev:windmill": "nx dev windmill-service",
    "dev:all": "nx run-many --target=dev --all --parallel",
    "build": "nx run-many --target=build --all",
    "build:web": "nx build web-app",
    "build:core": "nx build core",
    "build:windmill": "nx build windmill-service",
    "start": "nx start web-app",
    "test": "nx run-many --target=test --all",
    "test:web": "nx test web-app",
    "test:core": "nx test core",
    "test:windmill": "nx test windmill-service",
    "lint": "nx run-many --target=lint --all --parallel",
    "type-check": "nx run-many --target=type-check --all --parallel",
    "type-check:core": "nx type-check core",
    "type-check:web": "nx type-check web-app",
    "type-check:windmill": "nx type-check windmill-service",
    "format": "prettier --write .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "extract-agent": "node tools/agent-extractor/cli/extract-agent.js",
    "deploy": "npm run build && npm run start",
    "health": "curl -f http://localhost:3002/api/agent || echo 'Server not running. Start with: npm run dev'",
    "graph": "nx graph",
    "affected:build": "nx affected --target=build",
    "affected:test": "nx affected --target=test",
    "affected:type-check": "nx affected --target=type-check",
    "clean": "nx reset && rm -rf packages/*/dist packages/*/.next"
  },
  "devDependencies": {
    "@nx/js": "^21.4.0",
    "@nx/next": "^21.4.0",
    "@nx/node": "^21.4.0",
    "@nx/workspace": "^21.4.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.0",
    "nx": "21.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "ai",
    "platform-engineering",
    "nextjs",
    "react",
    "tailwindcss",
    "approval-workflow",
    "kubernetes",
    "devops",
    "anthropic",
    "conversational-ai",
    "claude",
    "agent-integration",
    "real-agent",
    "modular-architecture",
    "safety-validation"
  ],
  "author": "Platform Engineering Team",
  "license": "MIT"
}
