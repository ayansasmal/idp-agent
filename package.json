{
  "name": "ai-idp-modular",
  "version": "1.0.0",
  "description": "AI-Powered Integrated Developer Platform - Modular Single Agent Architecture",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:core\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:core": "npm run dev --workspace=packages/core",
    "dev:web": "npm run dev --workspace=packages/web-interface", 
    "dev:slack": "npm run dev --workspace=packages/slack-app",
    "dev:cli": "npm run dev --workspace=packages/cli",
    "dev:api": "npm run dev --workspace=packages/api-server",
    "build": "npm run build --workspaces",
    "build:core": "npm run build --workspace=packages/core",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "format": "prettier --write .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "extract-agent": "node tools/agent-extractor/cli/extract-agent.js",
    "deploy": "npm run build && node tools/deployment/scripts/deploy.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "ai",
    "platform-engineering",
    "kubernetes", 
    "devops",
    "anthropic",
    "conversational-ai"
  ],
  "author": "Platform Engineering Team",
  "license": "MIT"
}