{
  "name": "ai-idp-modular",
  "version": "2.0.0",
  "description": "AI-Powered Integrated Developer Platform with Real Agent Integration, Next.js Web Application, and Human Approval Workflow",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=packages/web-app",
    "dev:web-standalone": "npm run dev:standalone --workspace=packages/web-app",
    "dev:core": "npm run dev --workspace=packages/core",
    "dev:slack": "npm run dev --workspace=packages/slack-app",
    "dev:cli": "npm run dev --workspace=packages/cli",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=packages/web-app",
    "build:core": "npm run build --workspace=packages/core",
    "start": "npm run start --workspace=packages/web-app",
    "test": "npm run test --workspaces",
    "test:web": "npm run test --workspace=packages/web-app",
    "test:core": "npm run test --workspace=packages/core",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "format": "prettier --write .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "extract-agent": "node tools/agent-extractor/cli/extract-agent.js",
    "deploy": "npm run build && npm run start",
    "health": "curl -f http://localhost:3002/api/agent || echo 'Server not running. Start with: npm run dev'"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "ai",
    "platform-engineering",
    "nextjs",
    "react",
    "tailwindcss",
    "approval-workflow",
    "kubernetes", 
    "devops",
    "anthropic",
    "conversational-ai",
    "claude",
    "agent-integration",
    "real-agent",
    "modular-architecture",
    "safety-validation"
  ],
  "author": "Platform Engineering Team",
  "license": "MIT"
}