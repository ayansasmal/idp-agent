# AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_fallback_key
AI_PRIMARY_PROVIDER=anthropic
AI_MAX_RETRIES=3
AI_BACKOFF_MS=1000
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Database Configuration
DATABASE_URL=postgresql://ai_idp:password@localhost:5432/ai_idp
REDIS_URL=redis://localhost:6379
QDRANT_URL=https://f45182aa-ef14-448a-b942-f20cc2dfeeb6.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=meta_agent_context
QDRANT_VECTOR_SIZE=384

# DynamoDB Configuration
APPROVALS_TABLE_NAME=ai-idp-approvals
CHAT_SESSIONS_TABLE_NAME=ai-idp-chat-sessions
ACTION_TRACKING_TABLE_NAME=ai-idp-action-tracking
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566

# Kubernetes Configuration
KUBECONFIG=/Users/ayan/.kube/config
KUBERNETES_NAMESPACE=ai-idp

# Slack Configuration (Optional)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APPROVAL_CHANNEL=#platform-approvals

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-must-be-32-chars-minimum-for-security
SESSION_SECRET=your-session-secret-must-be-32-chars-minimum-for-security  
ENCRYPTION_KEY=12345678901234567890123456789012

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info

# Action Manager Configuration  
ACTION_MANAGER_ENABLED=false

# Service Ports
META_AGENT_PORT=3000
INFRASTRUCTURE_AGENT_PORT=3003
OBSERVABILITY_AGENT_PORT=3005
WEB_PORT=3002
API_PORT=3001
SLACK_PORT=3004

# Communication Architecture Feature Flags
USE_WEBSOCKET=true                    # Current: WebSocket communication
ENABLE_SSE_HTTP=false                # New: SSE + HTTP communication  
MIGRATION_PHASE=current              # Options: current, testing, production

# MCP Communication (Meta-Agent connects to focused agents)
MCP_SERVER_PORT=3003

# URLs (for cross-service communication)
META_AGENT_URL=http://localhost:3000
INFRASTRUCTURE_AGENT_URL=http://localhost:3003
OBSERVABILITY_AGENT_URL=http://localhost:3005

# Observability Agent Configuration (SLM-Powered)
SLM_PROVIDER=ollama
SLM_MODEL=llama3:latest
OLLAMA_BASE_URL=http://localhost:11434
SLM_MAX_TOKENS=2048
SLM_TEMPERATURE=0.1

# Observability Tools (Optional - for production monitoring)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3006
GRAFANA_API_KEY=your-grafana-api-key
ALERTMANAGER_URL=http://localhost:9093
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX_PATTERN=logs-*

# LocalStack (for local AWS services)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Monitoring (Optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
SENTRY_DSN=your-sentry-dsn

# Windmill
WINDMILL_TOKEN=your_windmill_token
WINDMILL_WORKSPACE=Kube