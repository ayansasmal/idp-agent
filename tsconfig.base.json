{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@ai-idp/core": ["./packages/core/src"],
      "@ai-idp/core/*": ["./packages/core/src/*"],
      "@ai-idp/web": ["./packages/web-interface/src"],
      "@ai-idp/slack": ["./packages/slack-app/src"],
      "@ai-idp/cli": ["./packages/cli/src"],
      "@ai-idp/api": ["./packages/api-server/src"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "tools/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}