# AI Configuration
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_fallback_key
AI_PRIMARY_PROVIDER=anthropic
AI_MAX_RETRIES=3
AI_BACKOFF_MS=1000

# Database Configuration
DATABASE_URL=postgresql://ai_idp:password@localhost:5432/ai_idp
REDIS_URL=redis://localhost:6379

# Kubernetes Configuration
KUBECONFIG=~/.kube/config
KUBERNETES_NAMESPACE=ai-idp

# Slack Configuration (Optional)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APPROVAL_CHANNEL=#platform-approvals

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key
SESSION_SECRET=your-session-secret
ENCRYPTION_KEY=your-encryption-key-32-chars

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
API_PORT=3001
WEB_PORT=3002
SLACK_PORT=3003

# LocalStack (for local AWS services)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Monitoring (Optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
SENTRY_DSN=your-sentry-dsn