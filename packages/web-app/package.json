{
  "name": "@ai-idp/web-app",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:with-core",
    "dev:standalone": "next dev --port 3002",
    "dev:with-core": "concurrently \"npm run dev:core\" \"npm run dev:standalone\"",
    "dev:core": "cd ../core && npm run dev",
    "build": "npm run build:core && next build",
    "build:core": "cd ../core && npm run build",
    "start": "next start --port 3002",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.85.5",
    "ai": "^5.0.16",
    "nanoid": "^5.1.5",
    "next": "15.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-jsx": "^5.1.6",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
