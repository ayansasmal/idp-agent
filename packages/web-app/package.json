{
  "name": "@ai-idp/web-app",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:with-meta-agent",
    "dev:standalone": "next dev --port 3002",
    "dev:with-meta-agent": "concurrently \"npm run dev:meta-agent\" \"npm run dev:standalone\"",
    "dev:meta-agent": "cd ../meta-agent && npm run dev",
    "build": "npm run build:meta-agent && next build",
    "build:meta-agent": "cd ../meta-agent && npm run build && echo '@ai-idp/meta-agent Build complete'",
    "start": "next start --port 3002",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-idp/meta-agent": "file:../meta-agent",
    "@ai-idp/types": "file:../shared/types",
    "@anthropic-ai/sdk": "^0.60.0",
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-query": "^5.85.5",
    "ai": "^5.0.24",
    "nanoid": "^5.1.5",
    "next": "^15.5.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-jsx": "^5.1.7",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}