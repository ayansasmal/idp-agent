{
  "name": "@ai-idp/core",
  "version": "1.0.0",
  "description": "Core AI agent with modular architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --skipLibCheck --noEmit false && tsc-alias",
    "build:lenient": "tsc --skipLibCheck --noImplicitAny false --strict false --noEmit false && tsc-alias",
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run tests/integration/",
    "test:system": "tsx src/test-system.ts",
    "test:quick": "tsx src/quick-test.ts",
    "test:interactive": "tsx src/interactive-test.ts",
    "lint": "eslint src/ --ext .ts",
    "type-check": "tsc --noEmit",
    "type-check:lenient": "tsc --skipLibCheck --noImplicitAny false --strict false --noEmit"
  },
  "dependencies": {
    "langchain": "^0.3.31",
    "@langchain/core": "^0.3.72",
    "@langchain/anthropic": "^0.3.26",
    "@anthropic-ai/sdk": "^0.60.0",
    "zod": "^4.0.17",
    "dotenv": "^17.2.1",
    "@kubernetes/client-node": "^1.3.0",
    "js-yaml": "^4.1.0",
    "fastify": "^5.5.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "prisma": "^6.14.0",
    "@prisma/client": "^6.14.0",
    "redis": "^5.8.1",
    "ioredis": "^5.7.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "@aws-sdk/client-dynamodb": "^3.868.0",
    "@aws-sdk/lib-dynamodb": "^3.868.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.4",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "pino-pretty": "^13.1.1"
  },
  "overrides": {
    "@langchain/core": "0.3.68"
  },
  "resolutions": {
    "@langchain/core": "0.3.68"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}