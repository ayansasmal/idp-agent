{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@/shared/*": ["./shared/*"],
      "@/modules/*": ["./modules/*"],
      "@/ai/*": ["./ai/*"],
      "@/agent/*": ["./agent/*"],
      "@/types": ["./types/index"],
      "@/types/*": ["./types/*"],
      "@windmill/*": ["../windmill-service/dist/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}