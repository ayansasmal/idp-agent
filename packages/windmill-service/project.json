{
  "name": "windmill-service",
  "root": "packages/windmill-service",
  "sourceRoot": "packages/windmill-service/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/windmill-service/dist",
        "main": "packages/windmill-service/src/index.ts",
        "tsConfig": "packages/windmill-service/tsconfig.json",
        "assets": []
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx watch src/index.ts",
        "cwd": "packages/windmill-service"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/index.js",
        "cwd": "packages/windmill-service"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/windmill-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest",
        "cwd": "packages/windmill-service"
      }
    }
  },
  "tags": ["scope:backend", "type:library"]
}