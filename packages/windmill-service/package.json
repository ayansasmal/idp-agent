{
  "name": "@ai-idp/windmill-service",
  "version": "1.0.0",
  "description": "Module-agnostic Windmill integration service for AI-IDP platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "windmill",
    "workflow",
    "automation",
    "kubectl",
    "kubernetes"
  ],
  "dependencies": {
    "windmill-client": "^1.494.0",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "zod": "^3.22.4",
    "pino": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "tsx": "^4.7.1",
    "tsc-alias": "^1.8.8",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}