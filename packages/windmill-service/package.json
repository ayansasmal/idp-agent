{
  "name": "@ai-idp/windmill-service",
  "version": "1.0.0",
  "description": "Module-agnostic Windmill integration service for AI-IDP platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "windmill",
    "workflow",
    "automation",
    "kubectl",
    "kubernetes"
  ],
  "dependencies": {
    "windmill-client": "^1.528.0",
    "fastify": "^5.5.0",
    "@fastify/cors": "^11.1.0",
    "zod": "^4.0.17",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "tsx": "^4.20.4",
    "tsc-alias": "^1.8.16",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}