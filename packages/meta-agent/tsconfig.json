{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@ai-idp/types": ["../shared/types/src"],
      "@ai-idp/utils": ["../shared/utils/src"],
      "@ai-idp/qdrant-client": ["../shared/qdrant-client/src"],
      "@ai-idp/mcp-client": ["../shared/mcp-client/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../shared/types" },
    { "path": "../shared/utils" },
    { "path": "../shared/qdrant-client" }, 
    { "path": "../shared/mcp-client" }
  ]
}