{
  "entryPoints": [
    "./packages/meta-agent/src/agent/MetaAgent.ts",
    "./packages/meta-agent/src/agent/ResponseCoordinator.ts",
    "./packages/meta-agent/src/routing/IntentClassifier.ts",
    "./packages/meta-agent/src/context/ContextManager.ts",
    "./packages/agents/infrastructure/src/agent/InfrastructureAgent.ts",
    "./packages/core/src/agent/PrimaryAgent.ts",
    "./packages/shared/types/src/index.ts",
    "./packages/shared/mcp-client/src/index.ts",
    "./packages/shared/qdrant-client/src/index.ts",
    "./packages/shared/utils/src/index.ts",
    "./packages/shared/utils/src/http/factory.ts",
    "./packages/shared/utils/src/logging/factory.ts",
    "./packages/shared/utils/src/errors/classes.ts"
  ],
  "out": "./docs-generated",
  "theme": "default",
  "name": "AI-IDP Multi-Agent Platform",
  "readme": "./README.md",
  "includeVersion": true,
  "excludeExternals": true,
  "excludePrivate": false,
  "excludeProtected": false,
  "disableSources": false,
  "skipErrorChecking": true,
  "sourceLinkTemplate": "https://github.com/your-org/ai-idp/blob/main/{path}#L{line}",
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Meta-Agent",
    "Focused Agents",
    "Core Agent", 
    "Types & Interfaces",
    "MCP Communication",
    "Vector Database",
    "Utilities",
    "HTTP & Logging",
    "*"
  ],
  "sort": ["source-order"],
  "kindSortOrder": [
    "Reference",
    "Project",
    "Module",
    "Namespace", 
    "Enum",
    "EnumMember",
    "Class",
    "Interface",
    "TypeAlias",
    "Constructor",
    "Property",
    "Variable",
    "Function",
    "Method",
    "Parameter",
    "TypeParameter",
    "Accessor",
    "GetSignature",
    "SetSignature",
    "CallSignature",
    "ConstructorSignature"
  ],
  "searchInComments": true,
  "searchInDocuments": true,
  "cleanOutputDir": true,
  "treatWarningsAsErrors": false,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "commentStyle": "jsdoc"
}